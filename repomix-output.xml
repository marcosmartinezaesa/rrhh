const $=s=>document.querySelector(s);
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
let people=[],campaigns=[],me,view='candidates',selected=new Set(),needsSetup=false;
async function api(url,options={}){const r=await fetch('/api'+url,{...options,headers:options.body instanceof FormData?{}:{'Content-Type':'application/json'},body:options.body instanceof FormData?options.body:options.body?JSON.stringify(options.body):undefined});const data=await r.json();if(!r.ok){if(r.status===401&&url!=='/login'){showLogin();}throw Error(data.error||'No se pudo completar la operación');}return data;}
function toast(message){$('#toast').textContent=message;$('#toast').hidden=false;clearTimeout(toast.timer);toast.timer=setTimeout(()=>$('#toast').hidden=true,6500);}
function bind(selector,event,fn){$(selector)?.addEventListener(event,async e=>{try{await fn(e);}catch(err){toast(err.message);}});}
function modal(html){$('#modalContent').innerHTML=html;$('#modal').showModal();bind('#closeModal','click',()=>$('#modal').close());}
const modalHead=title=>`<div class="modal-head"><h2>${esc(title)}</h2><button type="button" id="closeModal" aria-label="Cerrar">×</button></div>`;
const options=(items,current)=>items.map(x=>`<option ${x===current?'selected':''}>${esc(x)}</option>`).join('');
async function showLogin(){needsSetup=(await api('/auth')).needsSetup;$('#app').hidden=true;$('#login').hidden=false;$('#setupLabel').hidden=!needsSetup;$('#loginButton').textContent=needsSetup?'Crear administrador':'Ingresar';}
bind('#loginForm','submit',async e=>{e.preventDefault();$('#loginError').textContent='';const body=Object.fromEntries(new FormData(e.target));try{if(needsSetup)await api('/setup',{method:'POST',body});await api('/login',{method:'POST',body});e.target.reset();await boot();}catch(err){$('#loginError').textContent=err.message;}});
bind('#logout','click',async()=>{await api('/logout',{method:'POST'});$('#modal').close();await showLogin();});
document.querySelectorAll('[data-view]').forEach(b=>b.addEventListener('click',()=>{view=b.dataset.view;render();}));
async function refresh(){[people,campaigns]=await Promise.all([api('/candidates'),api('/campaigns')]);}
async function boot(){me=await api('/me');await refresh();$('#identity').textContent=me.username;$('#login').hidden=true;$('#app').hidden=false;render();}
function render(){document.querySelectorAll('[data-view]').forEach(b=>b.classList.toggle('active',b.dataset.view===view));$('#breadcrumb').textContent={candidates:'Postulantes',campaigns:'Convocatorias',settings:'Configuración'}[view];({candidates:renderPeople,campaigns:renderCampaigns,settings:renderSettings}[view])();}
function renderPeople(){const confirmed=campaigns.reduce((n,c)=>n+c.invitations.filter(i=>i.status==='Confirmó').length,0);$('#content').innerHTML=`<div class="heading"><div><h1>Encontrá tu próximo equipo.</h1><p>Todos los postulantes, un solo lugar para dar el siguiente paso.</p></div><div class="actions"><button id="import">↑ &nbsp; Importar Excel</button><button class="primary" id="new">+ &nbsp; Nuevo postulante</button></div></div><div class="stats">${[['Postulantes',people.length,'Fichas en tu base'],['Por revisar',people.filter(p=>p.status==='Pendiente').length,'Pendientes de evaluación'],['Preseleccionados',people.filter(p=>p.status==='Preseleccionado').length,'Revisados por el equipo'],['Confirmaciones',confirmed,'En todas las convocatorias']].map(([a,b,c])=>`<div class="stat"><small>${a}</small><strong>${b}</strong><span>${c}</span></div>`).join('')}</div><div class="panel"><div class="heading"><h2>Base de postulantes</h2><span class="muted">Selección con revisión humana</span></div><div class="filters"><input id="search" placeholder="Buscar nombre, teléfono o localidad" aria-label="Buscar postulantes"><select id="statusFilter" aria-label="Estado">${options(['Todos los estados','Pendiente','Revisado','Preseleccionado','Archivado'])}</select><select id="licenseFilter" aria-label="Licencia">${options(['Todas las licencias','B1','B2','C1','C2','C3','E1','Sin dato'])}</select><input id="radius" type="number" min="0" placeholder="Radio máximo (km)" aria-label="Radio máximo en kilómetros"></div><div class="toolbar"><span id="selectionCount" class="muted"></span><button id="addToCampaign">Agregar a convocatoria</button><button id="reload">↻ Actualizar</button></div><div class="table-wrap"><table><thead><tr><th></th><th>POSTULANTE</th><th>LOCALIDAD</th><th>LICENCIA</th><th>DISTANCIA</th><th>ESTADO</th><th></th></tr></thead><tbody id="rows"></tbody></table></div><div id="empty" class="empty" hidden></div></div><div class="notice">Ubicación de referencia: Juan Manuel de Rosas 21028, Virrey del Pino. Radio inicial sugerido: 15 km, pendiente de validar. Las distancias se cargan manualmente; si faltan, el postulante permanece visible para revisión.</div>`;bind('#new','click',()=>editPerson());bind('#import','click',importExcel);bind('#reload','click',async()=>{await refresh();render();});bind('#addToCampaign','click',addToCampaign);['#search','#statusFilter','#licenseFilter','#radius'].forEach(s=>bind(s,'input',drawRows));drawRows();}
function drawRows(){const term=$('#search').value.toLowerCase();const status=$('#statusFilter').value;const license=$('#licenseFilter').value;const radius=$('#radius').value;const rows=people.filter(p=>[p.name,p.phone,p.cvPhone,p.locality].join(' ').toLowerCase().includes(term)&&(status==='Todos los estados'||p.status===status)&&(license==='Todas las licencias'||(license==='Sin dato'?!p.license:p.license.toUpperCase().split(/[\s,;/]+/).includes(license)))&&(!radius||p.distance==null||p.distance<=Number(radius)));$('#rows').innerHTML=rows.map(p=>`<tr><td><input type="checkbox" aria-label="Seleccionar ${esc(p.name)}" data-select="${p.id}" ${selected.has(p.id)?'checked':''}></td><td><div class="person"><span class="avatar">${esc(p.name.split(' ').map(s=>s[0]).slice(0,2).join('').toUpperCase())}</span><div>${esc(p.name)}<small>${esc(p.phone||(p.cvPhone?'CV: '+p.cvPhone:'WhatsApp por confirmar'))}</small></div></div></td><td>${esc(p.locality||'Por confirmar')}</td><td>${esc(p.license||'Sin dato')}</td><td>${p.distance==null?'Por confirmar':esc(p.distance)+' km'}</td><td><span class="badge ${p.status==='Preseleccionado'?'green':''}">${esc(p.status)}</span></td><td><button data-edit="${p.id}">Ver ficha ↗</button></td></tr>`).join('');$('#empty').hidden=!!rows.length;$('#empty').innerHTML=people.length?'<strong>No hay coincidencias</strong>Probá con otros filtros.':'<strong>Un nuevo equipo empieza con una ficha</strong>Cargá el primer postulante o importá un Excel para empezar.';document.querySelectorAll('[data-edit]').forEach(b=>b.onclick=()=>editPerson(Number(b.dataset.edit)).catch(e=>toast(e.message)));document.querySelectorAll('[data-select]').forEach(b=>b.onchange=()=>{const id=Number(b.dataset.select);b.checked?selected.add(id):selected.delete(id);selectionCount();});selectionCount();}
function selectionCount(){$('#selectionCount').textContent=`${selected.size} seleccionados`;}
async function editPerson(id){const p=id?await api('/candidates').then(rows=>rows.find(r=>r.id===id)):{};if(!p)throw Error('Ficha no encontrada');const input=(key,label,type='text')=>`<label>${label}<input name="${key}" type="${type}" ${key==='name'?'required':''} ${type==='number'?'min="0" step="0.1"':''} value="${esc(p[key])}"></label>`;modal(`${modalHead(id?'Ficha del postulante':'Nuevo postulante')}<form id="personForm"><div class="form-grid">${input('name','Nombre y apellido')}${input('phone','WhatsApp del chat')}${input('cvPhone','Teléfono indicado en el CV')}${input('locality','Localidad')}${input('address','Domicilio declarado')}${input('distance','Distancia verificada (km)','number')}${input('license','Licencia declarada (ej.: B1, C1)')}${input('licenseExpiry','Vencimiento de licencia','date')}<label>Mayoría de edad declarada<select name="adult">${options(['Por confirmar','Sí','No'],p.adult)}</select></label><label>Estado de revisión<select name="status">${options(['Pendiente','Revisado','Preseleccionado','Archivado'],p.status)}</select></label>${input('availability','Disponibilidad y traslado')}${input('source','Origen del dato')}<label class="wide">Experiencia<textarea name="experience">${esc(p.experience)}</textarea></label><label class="wide">Notas y evidencias<textarea name="notes">${esc(p.notes)}</textarea></label></div><div id="phoneWarning" class="notice" hidden>El WhatsApp del chat difiere del teléfono del CV. Verificá a quién corresponde antes de contactar.</div><div class="form-actions"><button class="primary">Guardar ficha</button></div></form>${id?'<hr><h3>Currículums y lectura</h3><p class="muted">PDF, JPG o PNG · máximo 15 MB. Los datos extraídos deben verificarse y copiarse a la ficha.</p><form id="uploadForm" class="toolbar"><input name="file" type="file" accept=".pdf,.png,.jpg,.jpeg" required><button>Cargar y leer CV</button></form><div id="documents"></div>':'<p class="muted">Guardá la ficha para adjuntar el CV.</p>'}`);const warning=()=>{const f=$('#personForm');const a=f.elements.phone.value.replace(/\D/g,'');const b=f.elements.cvPhone.value.replace(/\D/g,'');$('#phoneWarning').hidden=!(a&&b&&a!==b);};bind('#personForm','input',warning);warning();bind('#personForm','submit',async e=>{e.preventDefault();const body={...Object.fromEntries(new FormData(e.target)),version:p.version};await api(id?'/candidates/'+id:'/candidates',{method:id?'PUT':'POST',body});$('#modal').close();await refresh();render();toast('Ficha guardada');});if(id){await documents(id);bind('#uploadForm','submit',async e=>{e.preventDefault();const b=e.target.querySelector('button');b.disabled=true;try{await api(`/candidates/${id}/documents`,{method:'POST',body:new FormData(e.target)});e.target.reset();await documents(id);toast('CV guardado. La lectura se procesa en el servidor.');}finally{b.disabled=false;}});}}
async function documents(id){const docs=await api(`/candidates/${id}/documents`);$('#documents').innerHTML=docs.map(d=>`<details><summary>${esc(d.original)} · ${esc(d.status)}</summary><p><a href="/api/documents/${d.id}">Descargar original</a></p><pre>${esc(d.text||'Sin texto disponible todavía. Actualizá la lectura en unos instantes.')}</pre></details>`).join('')+'<button type="button" id="refreshDocs">Actualizar lectura</button>';bind('#refreshDocs','click',()=>documents(id));}
function importExcel(){modal(`${modalHead('Importar postulantes desde Excel')}<p>Se detecta la hoja EVALUACION o la primera hoja y sus encabezados. Los datos adicionales se conservan en notas. Revisá la vista previa antes de incorporar las fichas.</p><form id="excelForm" class="toolbar"><input type="file" name="file" accept=".xlsx" required><button class="primary">Leer archivo</button></form><div id="preview"></div>`);bind('#excelForm','submit',async e=>{e.preventDefault();const result=await api('/import/preview',{method:'POST',body:new FormData(e.target)});const good=result.rows.filter(r=>r.name);$('#preview').innerHTML=`<p>${esc(result.sheet)} · Encabezados en fila ${result.headerRow} · ${good.length} filas con nombre / ${result.rows.length} filas totales.</p><p class="muted">Columnas conservadas en notas: ${esc(result.headers.filter(h=>!h.field).map(h=>h.label).join(', ')||'Ninguna')}. Los resultados del Excel quedan como antecedentes; todas las fichas se importan pendientes de revisión.</p><div class="table-wrap"><table><thead><tr><th>Nombre</th><th>Contacto</th><th>Localidad</th><th>Licencia</th></tr></thead><tbody>${good.slice(0,100).map(r=>`<tr><td>${esc(r.name)}</td><td>${esc(r.phone||r.cvPhone)}</td><td>${esc(r.locality)}</td><td>${esc(r.license)}</td></tr>`).join('')}</tbody></table></div><p class="muted">Vista previa de hasta 100 filas. Duplicados exactos por nombre y ambos teléfonos se omiten. Las filas sin nombre no se importan.</p><button id="commitImport" class="primary" ${good.length?'':'disabled'}>Importar ${good.length} fichas</button>`;bind('#commitImport','click',async e=>{e.target.disabled=true;try{const r=await api('/import/commit',{method:'POST',body:{rows:good}});$('#modal').close();await refresh();render();toast(`${r.added} fichas importadas; ${r.skipped} duplicadas omitidas`);}finally{e.target.disabled=false;}});});}
function renderCampaigns(){$('#content').innerHTML=`<div class="heading"><div><h1>Conversaciones que abren puertas.</h1><p>Organizá entrevistas y registrá cada respuesta.</p></div><button id="newCampaign" class="primary">+ Nueva convocatoria</button></div>${campaigns.length?campaigns.map(c=>`<div class="panel"><div class="campaign"><div><h2>${esc(c.title)}</h2><p>${esc(c.date)} · ${esc(c.time)} hs · Cupo: ${c.capacity}</p><button data-campaign="${c.id}">Ver convocatoria ↗</button></div><div><strong>${c.invitations.length} / ${c.capacity}</strong><small>seleccionados</small></div><div><strong>${c.invitations.filter(i=>i.status==='Confirmó').length}</strong><small>confirmados</small></div></div></div>`).join(''):'<div class="panel empty"><strong>Prepará tu primera convocatoria</strong>Definí fecha, hora y cupo; luego agregá personas desde Postulantes.</div>'}<div class="notice">Las invitaciones se preparan para copiar. El envío y la confirmación se registran manualmente en esta etapa.</div>`;bind('#newCampaign','click',newCampaign);document.querySelectorAll('[data-campaign]').forEach(b=>b.onclick=()=>campaignDetail(Number(b.dataset.campaign)));}
function newCampaign(){modal(`${modalHead('Nueva convocatoria')}<form id="campaignForm"><div class="form-grid"><label class="wide">Título<input name="title" required placeholder="Entrevistas · Reparto y distribución"></label><label>Fecha<input name="date" type="date" required></label><label>Horario de inicio<input name="time" type="time" required></label><label>Cupo de postulantes<input name="capacity" type="number" min="1" max="1000" value="40" required></label></div><div class="form-actions"><button class="primary">Crear convocatoria</button></div></form>`);bind('#campaignForm','submit',async e=>{e.preventDefault();await api('/campaigns',{method:'POST',body:Object.fromEntries(new FormData(e.target))});$('#modal').close();await refresh();render();});}
function addToCampaign(){if(!selected.size)return toast('Seleccioná al menos un postulante');if(!campaigns.length){view='campaigns';render();return newCampaign();}modal(`${modalHead('Agregar a una convocatoria')}<p>${selected.size} postulantes seleccionados, incluidos los que no se ven por los filtros.</p><form id="assignForm"><label>Convocatoria<select name="campaign">${campaigns.map(c=>`<option value="${c.id}">${esc(c.title)} · ${c.invitations.length}/${c.capacity}</option>`).join('')}</select></label><p class="muted">Agregar personas no envía mensajes.</p><button class="primary">Agregar selección</button></form>`);bind('#assignForm','submit',async e=>{e.preventDefault();await api(`/campaigns/${e.target.elements.campaign.value}/invitations`,{method:'POST',body:{ids:[...selected]}});selected.clear();$('#modal').close();await refresh();render();toast('Selección agregada a la convocatoria');});}
function campaignDetail(id){const c=campaigns.find(c=>c.id===id);modal(`${modalHead(c.title)}<p>${esc(c.date)} · ${esc(c.time)} hs · ${c.invitations.length}/${c.capacity} seleccionados · ${c.invitations.filter(i=>i.status==='Confirmó').length} confirmados</p><div class="table-wrap"><table><thead><tr><th>Postulante</th><th>Respuesta / asistencia</th><th>Invitación</th></tr></thead><tbody>${c.invitations.map(i=>`<tr><td>${esc(i.name)}<br><small>${esc(i.phone||'Sin teléfono')}</small></td><td><select aria-label="Estado de ${esc(i.name)}" data-invite="${i.candidate_id}">${options(['Seleccionado','Invitado','Confirmó','No puede asistir','Sin respuesta','Asistió','No asistió'],i.status)}</select></td><td><button data-message="${i.candidate_id}">Preparar texto</button></td></tr>`).join('')}</tbody></table></div><div id="messageArea"></div>`);document.querySelectorAll('[data-invite]').forEach(s=>s.onchange=async()=>{try{await api(`/campaigns/${id}/invitations/${s.dataset.invite}`,{method:'PUT',body:{status:s.value}});await refresh();render();toast('Estado actualizado');}catch(e){toast(e.message);s.value=c.invitations.find(i=>i.candidate_id===Number(s.dataset.invite)).status;}});document.querySelectorAll('[data-message]').forEach(b=>b.onclick=()=>{const i=c.invitations.find(i=>i.candidate_id===Number(b.dataset.message));$('#messageArea').innerHTML=`<h3>Invitación para revisar y copiar</h3><textarea id="messageText" rows="6">${esc(`Hola ${i.name}, te contactamos de IVESS por tu postulación. Queremos invitarte a una entrevista el ${c.date} a las ${c.time} hs en Juan Manuel de Rosas 21028, Virrey del Pino. ¿Podés confirmar tu asistencia? ¡Gracias!`)}</textarea><p class="muted">Verificá el destinatario y el horario. Copiar el texto no envía el mensaje ni cambia el estado.</p><button id="copyMessage">Seleccionar texto para copiar</button>`;$('#copyMessage').onclick=()=>{$('#messageText').select();toast('Texto seleccionado. Usá Ctrl+C para copiar.');};});}
function renderSettings(){$('#content').innerHTML=`<div class="heading"><div><h1>Tu espacio de trabajo.</h1><p>Administración del servidor y conexiones.</p></div></div><div class="panel"><h2>WhatsApp</h2><span class="badge">Pendiente de integración</span><p>Cuenta prevista: +54 9 11 5147-5803. La sesión propia de RR. HH. se conectará al incorporar el proyecto Transferencias de referencia.</p><small>Esta versión no vincula, importa conversaciones ni envía mensajes.</small></div><div class="panel"><h2>Lectura y evaluación</h2><p>PDF con texto: extracción directa. PDF escaneado e imágenes: OCR local. El texto original queda junto al archivo para verificar los datos.</p><p class="muted">No se calculan distancias por localidad ni se descartan personas automáticamente por edad. La licencia, disponibilidad, experiencia y traslado se revisan en cada ficha.</p></div>${me.role==='admin'?'<div class="panel"><h2>Nuevo usuario</h2><form id="userForm" class="form-grid"><label>Usuario<input name="username" required autocomplete="off"></label><label>Contraseña (mínimo 12 caracteres)<input name="password" type="password" minlength="12" required autocomplete="new-password"></label><div><button class="primary">Crear usuario</button></div></form></div><div class="panel"><h2>Copias de seguridad</h2><p>Guarda una copia de la base central y los CV en la carpeta backups del servidor.</p><button id="backup">Crear copia ahora</button><p id="backupResult" class="muted"></p></div>':''}`;bind('#userForm','submit',async e=>{e.preventDefault();await api('/users',{method:'POST',body:Object.fromEntries(new FormData(e.target))});e.target.reset();toast('Usuario creado');});bind('#backup','click',async e=>{e.target.disabled=true;try{const r=await api('/backup',{method:'POST'});$('#backupResult').textContent='Copia creada: '+r.path;}finally{e.target.disabled=false;}});}
boot().catch(()=>showLogin());
</file>

<file path="public/index.html">
<!doctype html>
<html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>IVESS · Personas</title><link rel="stylesheet" href="/style.css?v=3"></head><body>
<div id="login" class="login"><div class="login-card"><div class="waterline"></div><div class="brand"><img src="/assets/reference-logo-0.png" alt="IVESS"><span>RECURSOS HUMANOS</span></div><div class="login-eyebrow">GESTIÓN DE PERSONAS</div><h1>Tu equipo<br>empieza acá.</h1><p>Gestión de postulantes · Red interna</p><form id="loginForm"><label id="setupLabel" hidden>Clave de instalación<input name="token" autocomplete="off"><small>Disponible en data/clave-inicial.txt del servidor.</small></label><label>Usuario<input name="username" required autocomplete="username"></label><label>Contraseña<input name="password" type="password" required autocomplete="current-password"></label><button class="primary" id="loginButton">Ingresar</button><p id="loginError" role="alert"></p></form><div class="login-partner"><img src="/assets/reference-logo-1.png" alt="Atilio Etchelar S.A."><span>Un mismo equipo.<br>Más posibilidades.</span></div></div></div>
