<file path="public/reception.js">
const $=s=>document.querySelector(s);
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
let people=[],me,view='whatsapp',needsSetup=false,poll;
const date=s=>s?new Date(s).toLocaleString('es-AR',{timeZone:'America/Argentina/Buenos_Aires'}):'Por confirmar';
const stateLabel=s=>({done:'Lectura lista',partial:'Lectura parcial',pending:'Pendiente',reading:'Leyendo',error:'Error: revisar',ready:'Conectado',disconnected:'Desconectado',connecting:'Conectando',authenticated:'Autenticado',qr:'Esperando escaneo',saved:'Guardado',paused:'Pausado',running:'En curso'}[s]||s);
const day=()=>new Intl.DateTimeFormat('en-CA',{timeZone:'America/Argentina/Buenos_Aires'}).format(new Date());
async function api(url,options={}){const r=await fetch('/api'+url,{...options,headers:options.body instanceof FormData?{}:{'Content-Type':'application/json'},body:options.body instanceof FormData?options.body:options.body?JSON.stringify(options.body):undefined});const data=await r.json();if(!r.ok){if(r.status===401&&url!=='/login')showLogin();throw Error(data.error||'No se pudo completar la operación');}return data;}
function toast(message){$('#toast').textContent=message;$('#toast').hidden=false;clearTimeout(toast.timer);toast.timer=setTimeout(()=>$('#toast').hidden=true,7000);}
function bind(selector,event,fn){$(selector)?.addEventListener(event,async e=>{try{await fn(e);}catch(err){toast(err.message);}});}
function buttons(selector,fn){document.querySelectorAll(selector).forEach(b=>b.onclick=()=>Promise.resolve(fn(b)).catch(e=>toast(e.message)));}
function modal(html){$('#modalContent').innerHTML=html;if(!$('#modal').open)$('#modal').showModal();bind('#closeModal','click',()=>$('#modal').close());}
const head=title=>`<div class="modal-head"><h2>${esc(title)}</h2><button type="button" id="closeModal" aria-label="Cerrar">×</button></div>`;
const opts=(items,current)=>items.map(x=>`<option ${x===current?'selected':''}>${esc(x)}</option>`).join('');
async function showLogin(){clearInterval(poll);needsSetup=(await api('/auth')).needsSetup;$('#app').hidden=true;$('#login').hidden=false;$('#setupLabel').hidden=!needsSetup;$('#loginButton').textContent=needsSetup?'Crear administrador':'Ingresar';}
bind('#loginForm','submit',async e=>{e.preventDefault();const body=Object.fromEntries(new FormData(e.target));try{if(needsSetup)await api('/setup',{method:'POST',body});await api('/login',{method:'POST',body});e.target.reset();await boot();}catch(err){$('#loginError').textContent=err.message;}});
bind('#logout','click',async()=>{await api('/logout',{method:'POST'});$('#modal').close();await showLogin();});
document.querySelectorAll('[data-view]').forEach(b=>b.addEventListener('click',()=>{view=b.dataset.view;render().catch(e=>toast(e.message));}));
async function boot(){me=await api('/me');$('#identity').textContent=me.username;$('#login').hidden=true;$('#app').hidden=false;await render();}
async function render(){clearInterval(poll);document.querySelectorAll('[data-view]').forEach(b=>b.classList.toggle('active',b.dataset.view===view));$('#breadcrumb').textContent={candidates:'Postulantes y CV',whatsapp:'WhatsApp y sincronización',downloads:'Descargas por fecha',settings:'Configuración'}[view];await ({candidates:renderPeople,whatsapp:renderWhatsApp,downloads:renderDownloads,settings:renderSettings}[view])();}
const heading=(title,sub,buttons='')=>`<div class="heading"><div><h1>${title}</h1><p>${sub}</p></div><div class="actions">${buttons}</div></div>`;
async function renderWhatsApp(){
  $('#content').innerHTML=heading('Cada CV, en su lugar.','Vinculá la cuenta de RRHH y recuperá las postulaciones disponibles.')+`<div class="panel"><h2>Conexión de WhatsApp</h2><div id="waStatus"></div>${me.role==='admin'?`<form id="connectForm"><label class="checkline"><input type="checkbox" name="exclusive" required> Verifiqué que +54 9 11 5147-5803 no está administrado por otra integración.</label><div class="toolbar"><button class="primary">Iniciar conexión / mostrar QR</button><button type="button" id="disconnect">Desconectar RRHH</button></div></form><div id="qr"></div>`:'<p>Un administrador debe vincular la cuenta.</p>'}</div>${me.role==='admin'?`<div class="panel"><h2>Sincronización histórica</h2><p class="muted">Chats individuales. Se recupera el historial que WhatsApp permite consultar, hasta el límite configurado por chat.</p><form id="syncForm" class="form-grid"><label>Desde<input type="date" name="start" required value="${day()}"></label><label>Hasta<input type="date" name="end" required value="${day()}"></label><div class="toolbar wide"><button class="primary">Sincronizar rango</button><button type="button" id="cancelSync">Pausar</button><button type="button" id="retryMedia">Reintentar medios pendientes</button></div></form><div id="syncStatus"></div></div>`:''}<div class="panel"><h2>Adjuntos por revisar</h2><p class="muted">Los archivos dudosos se conservan hasta que confirmes si son CV y a quién pertenecen.</p><div id="receipts"></div></div>`;
  bind('#connectForm','submit',async e=>{e.preventDefault();await api('/whatsapp/connect',{method:'POST',body:{exclusiveAccount:e.target.elements.exclusive.checked}});await updateWhatsApp();});
  bind('#disconnect','click',async()=>{await api('/whatsapp/disconnect',{method:'POST'});await updateWhatsApp();});
  bind('#syncForm','submit',async e=>{e.preventDefault();await api('/sync',{method:'POST',body:Object.fromEntries(new FormData(e.target))});await updateWhatsApp();});
  bind('#cancelSync','click',()=>api('/sync/cancel',{method:'POST'}));bind('#retryMedia','click',async()=>{await api('/whatsapp/retry',{method:'POST'});toast('Reintento iniciado en segundo plano');});
  await updateWhatsApp();poll=setInterval(()=>{if(!$('#modal').open)updateWhatsApp().catch(e=>toast(e.message));},4000);
}
async function updateWhatsApp(){
  const [status,receipts]=await Promise.all([api('/whatsapp'),api('/receipts')]);if(view!=='whatsapp')return;
  $('#waStatus').innerHTML=`<p><span class="badge">${esc(stateLabel(status.state))}</span> Cuenta: ${esc(status.account||'Sin vincular')} · Última sincronización: ${date(status.lastSync)}</p>${status.error?`<div class="notice">${esc(status.error)}</div>`:''}`;
  if($('#qr'))$('#qr').innerHTML=status.qr?`<img class="qr" src="${esc(status.qr)}" alt="QR real para vincular WhatsApp"><p class="muted">WhatsApp → Dispositivos vinculados → Vincular un dispositivo.</p>`:'';
  if(me.role==='admin'){
    const jobs=await api('/sync');if(view!=='whatsapp')return;$('#syncStatus').innerHTML=jobs.map(j=>{const chats=Object.values(j.progress?.chats||{}),sum=k=>chats.reduce((n,c)=>n+(c[k]||0),0);return `<div class="notice"><strong>Trabajo ${j.id}: ${esc(stateLabel(j.state))}</strong> · ${j.cursor}/${j.progress?.totalChats||0} chats revisados<br>${sum('recovered')} mensajes recuperados · ${sum('saved')} adjuntos guardados · ${sum('duplicate')} duplicados · ${sum('errors')} errores<br>${chats.filter(c=>c.limitReached).length} chats alcanzaron el límite de consulta. ${j.state==='paused'?`<button data-resume="${j.id}">Reanudar</button>`:''}<details><summary>Cobertura y errores por chat</summary><pre>${esc(JSON.stringify(j.progress,null,2))}</pre></details></div>`;}).join('')||'<p class="muted">Todavía no se realizaron sincronizaciones.</p>';buttons('[data-resume]',b=>api(`/sync/${b.dataset.resume}/resume`,{method:'POST'}));
  }
  $('#receipts').innerHTML=receipts.length?`<div class="table-wrap"><table><thead><tr><th>Recepción</th><th>Origen</th><th>Archivo / estado</th><th></th></tr></thead><tbody>${receipts.map(r=>`<tr><td>${date(r.received)}</td><td>${esc(r.phone||r.chat)}</td><td>${esc(r.original||'Sin descargar')}<small class="block">${esc(r.error||r.read_state||r.state)}</small></td><td><button data-resolve="${r.id}">Revisar</button></td></tr>`).join('')}</tbody></table></div>`:'<p class="muted">No hay adjuntos pendientes de asociación.</p>';
  buttons('[data-resolve]',b=>resolveReceipt(receipts.find(r=>r.id===Number(b.dataset.resolve))));
}
async function resolveReceipt(r){people=await api('/candidates');modal(head('Revisar recepción')+`<p>${esc(r.chat)} · ${date(r.received)}<br>Mensaje: ${esc(r.message_id)}</p><pre>${esc([r.caption,r.context].filter(Boolean).join('\n'))}</pre>${r.hash?`<a href="/api/files/${r.hash}">Descargar original</a>`:''}<form id="resolveForm" class="form-grid"><label>Acción<select name="action"><option value="associate">Asociar a postulante existente</option><option value="new">Crear una ficha diferente</option><option value="other">No corresponde a una postulación</option></select></label><label>Postulante existente<select name="candidate_id">${people.map(p=>`<option value="${p.id}">N.º ${p.id} · ${esc(p.name)}</option>`).join('')}</select></label><label class="wide">Nombre, sólo para ficha nueva<input name="name" placeholder="Nombre por confirmar"></label><button class="primary wide">Guardar resolución</button></form>`);bind('#resolveForm','submit',async e=>{e.preventDefault();await api(`/receipts/${r.id}/resolve`,{method:'POST',body:Object.fromEntries(new FormData(e.target))});$('#modal').close();await updateWhatsApp();});}
async function renderPeople(){people=await api('/candidates');$('#content').innerHTML=heading('Postulantes y currículums.','Una ficha por persona, con versiones y recepciones trazables.','<button id="newPerson" class="primary">+ Nuevo postulante</button><button id="reload">Actualizar</button>')+`<div class="stats"><div class="stat"><small>Postulantes</small><strong>${people.length}</strong><span>Fichas únicas</span></div><div class="stat"><small>Con CV</small><strong>${people.filter(p=>p.current).length}</strong><span>Original disponible</span></div><div class="stat"><small>Por incorporar</small><strong>${people.filter(p=>!p.current).length}</strong><span>Sin archivo adjunto</span></div><div class="stat"><small>Lectura pendiente</small><strong>${people.filter(p=>p.current&&p.current.read_state!=='done').length}</strong><span>El CV se puede descargar</span></div></div><div class="panel"><input id="search" aria-label="Buscar postulantes" placeholder="Buscar por número, nombre, DNI o contacto"><div id="peopleRows"></div></div>`;bind('#newPerson','click',()=>personForm());bind('#reload','click',renderPeople);bind('#search','input',drawPeople);drawPeople();}
function drawPeople(){const q=$('#search').value.toLowerCase();const filtered=people.filter(p=>[p.id,p.name,p.phone,p.cvPhone,p.dniConfirmed,p.dniExtracted].join(' ').toLowerCase().includes(q));$('#peopleRows').innerHTML=`<div class="table-wrap"><table><thead><tr><th>Postulante</th><th>Contacto / DNI</th><th>Localidad / licencia</th><th>Primera recepción</th><th>CV vigente</th><th></th></tr></thead><tbody>${filtered.map(p=>`<tr><td><strong>N.º ${p.id}</strong> · ${esc(p.name)}</td><td>${esc(p.cvPhone||p.phone||'Por confirmar')}<small class="block">DNI: ${esc(p.dniConfirmed||p.dniExtracted||'Por confirmar')}</small></td><td>${esc(p.locality||'Por confirmar')}<small class="block">${esc(p.license||'Licencia por confirmar')}</small></td><td>${date(p.firstReceived)}</td><td>${p.current?`${p.current.date_known?date(p.current.incorporated):'Fecha por confirmar'}<small class="block">${esc(stateLabel(p.current.read_state))}</small>`:'Sin CV'}</td><td><button data-person="${p.id}">Ver ficha</button> ${p.current?`<a href="/api/files/${p.current.hash}">Descargar CV</a>`:''}</td></tr>`).join('')}</tbody></table></div>`;buttons('[data-person]',b=>personForm(Number(b.dataset.person)));}
async function personForm(id){
  const p=id?await api('/people/'+id):{name:'',versions:[],experiences:[],evidence:[],receipts:[],categories:[]};const current=p.versions[0];
  const input=(key,label,type='text')=>`<label>${label}<input name="${key}" type="${type}" value="${esc(p[key])}"></label>`;
  modal(head(id?`Postulante N.º ${id}`:'Nuevo postulante')+`<form id="personForm"><div class="form-grid">${input('name','Nombre completo')}${input('dniConfirmed','DNI confirmado')}${input('phone','WhatsApp del chat')}${input('cvPhone','Teléfono del CV')}${input('birthDate','Nacimiento declarado')}${input('declaredAge','Edad declarada')}${input('ageReference','Fecha de referencia de la edad','date')}${input('locality','Localidad')}${input('address','Domicilio')}${input('license','Licencia declarada')}${input('licenseExpiry','Vencimiento de licencia','date')}<label>Revisión de la ficha<select name="reviewState">${opts(['Por confirmar','Confirmado manualmente'],p.reviewState)}</select></label><label class="wide">Observaciones<textarea name="notes">${esc(p.notes)}</textarea></label></div><div class="form-actions"><button class="primary">Guardar datos</button></div></form>${id?`<hr><h3>Datos extraídos y fuentes</h3><p class="muted">DNI extraído: ${esc(p.dniExtracted||'Por confirmar')}. Los originales permanecen separados de los datos corregidos.</p>${p.evidence.map(e=>`<details><summary>${esc(e.field)}: ${esc(e.value)} · CV ${e.version_id}, página ${e.page??'por confirmar'}</summary><pre>${esc(e.fragment)}</pre></details>`).join('')||'<p class="muted">Sin atributos extraídos.</p>'}<hr><h3>CV vigente</h3>${current?`<p><a href="/api/files/${current.hash}">${esc(current.original)}</a> · ${current.date_known?date(current.incorporated):'Fecha de recepción por confirmar'}</p>`:'<p>Sin CV adjunto.</p>'}<form id="uploadForm" class="form-grid"><label>CV (PDF, JPG, PNG, hasta 15 MB)<input type="file" name="file" accept=".pdf,.jpg,.jpeg,.png" required></label><label>Fecha original de recepción<input type="datetime-local" name="received" required></label><button class="primary wide">Guardar CV y procesar en segundo plano</button></form><details><summary>Versiones de CV (${p.versions.length})</summary>${p.versions.map(v=>`<p>Versión ${v.id} · ${date(v.incorporated)} · ${esc(stateLabel(v.read_state))}<br><a href="/api/files/${v.hash}">Descargar original</a> <button data-text="${v.hash}">Leer texto</button> <button data-retry="${v.hash}">Reintentar lectura</button><small class="block">${esc(v.read_error)}</small></p>`).join('')}</details><details><summary>Recepciones (${p.receipts.length})</summary>${p.receipts.map(r=>`<p>${date(r.received)} · ${esc(r.phone||r.chat)}<small class="block">Mensaje: ${esc(r.message_id)}</small></p>`).join('')}</details><hr><h3>Experiencia laboral</h3><p class="muted">La lectura es orientativa. Revisá cada empleo y su fuente antes de confirmar.</p><button id="addExperience">+ Agregar empleo</button><div id="experiences"></div><details><summary>Texto original de experiencia conservado</summary><pre>${esc(p.experience||'Experiencia no informada')}</pre></details><details><summary>Duración por categoría del CV vigente</summary><p class="muted">Días calculados con fechas completas, sin duplicar períodos superpuestos. Los períodos incompletos no se suman.</p><pre>${esc(JSON.stringify(p.totals,null,2))}</pre></details>${me.role==='admin'?`<hr><button id="merge">Revisar unión con otra ficha</button>${p.matches.length?`<p class="notice">Coincidencias de DNI por revisar: ${p.matches.map(m=>'N.º '+m.id+' '+esc(m.name)).join(', ')}</p>`:''}`:''}`:''}`);
  bind('#personForm','submit',async e=>{e.preventDefault();const body={...p,...Object.fromEntries(new FormData(e.target))};body.name=body.name||'Nombre por confirmar';await api(id?'/candidates/'+id:'/candidates',{method:id?'PUT':'POST',body});$('#modal').close();if(view==='candidates')await renderPeople();toast('Ficha guardada');});
  if(!id)return;
  bind('#uploadForm','submit',async e=>{e.preventDefault();const button=e.target.querySelector('button');button.disabled=true;try{const form=new FormData(e.target);form.set('received',form.get('received')+':00-03:00');await api(`/candidates/${id}/documents`,{method:'POST',body:form});await personForm(id);toast('CV guardado. La lectura continúa en segundo plano.');}finally{button.disabled=false;}});
  buttons('[data-retry]',async b=>{await api('/files/'+b.dataset.retry+'/retry',{method:'POST'});toast('Lectura programada');});
  buttons('[data-text]',async b=>{const r=await api('/files/'+b.dataset.text+'/text');modal(head('Texto del CV')+`<button id="backPerson">Volver a la ficha</button>${r.pages.map(p=>`<h3>Página ${p.page??'por confirmar'} · ${esc(p.method)}</h3><pre>${esc(p.text)}</pre>`).join('')}<p>${esc(r.error)}</p>`);bind('#backPerson','click',()=>personForm(id));});
  const groups=new Map();for(const s of p.experiences){if(!groups.has(s.employment_id))groups.set(s.employment_id,[]);groups.get(s.employment_id).push(s);}
  $('#experiences').innerHTML=groups.size?[...groups].map(([job,sources])=>`<div class="employment"><h3>Empleo ${job}</h3>${sources.map(s=>`<details ${s.version_id===current?.id?'open':''}><summary>${esc(s.data.employer||'Empleador por confirmar')} · ${esc(s.data.role||'Puesto por confirmar')} · ${s.version_id?'CV '+s.version_id:'Carga manual'}</summary><p>${esc(s.data.tasks||'Tareas por confirmar')}</p><p>${esc(s.data.start||'Inicio por confirmar')} → ${esc(s.data.end||(s.data.current?'Actualidad':'Finalización por confirmar'))}</p><p>${esc(s.data.categories.join(' · ')||'Categorías por confirmar')}</p><span class="badge">${s.state==='confirmed'?'Confirmado manualmente':'Extraído / pendiente de revisión'}</span>${s.conflict?`<p class="notice">${esc(s.conflict)}</p>`:''}<pre>${esc(s.fragment)}</pre><small>Página: ${s.page??'por confirmar'} · Duración declarada: ${esc(s.data.declaredDuration||'Por confirmar')}<br>Duración calculada: ${s.duration?esc(s.duration.value+' '+s.duration.unit):'Por confirmar'}</small><p><button data-experience="${s.id}">Corregir / confirmar</button></p><details><summary>Historial de correcciones (${s.history.length})</summary><pre>${esc(JSON.stringify(s.history,null,2))}</pre></details></details>`).join('')}</div>`).join(''):'<p>Experiencia no informada.</p>';
  bind('#addExperience','click',()=>experienceForm(p));buttons('[data-experience]',b=>experienceForm(p,p.experiences.find(s=>s.id===Number(b.dataset.experience))));
  bind('#merge','click',()=>mergeForm(p));
}
function experienceForm(p,source){const d=source?.data||{};const input=(key,label)=>`<label>${label}<input name="${key}" value="${esc(d[key])}"></label>`;modal(head(source?'Corregir experiencia':'Agregar experiencia laboral')+`<form id="experienceForm"><div class="form-grid">${input('employer','Empresa o empleador')}${input('role','Puesto o cargo')}<label class="wide">Tareas declaradas<textarea name="tasks">${esc(d.tasks)}</textarea></label>${input('start','Inicio: AAAA, AAAA-MM o AAAA-MM-DD')}${input('end','Finalización con precisión disponible')}<label>¿Continúa trabajando allí?<select name="current">${opts(['Por confirmar','Sí','No'],d.current===true?'Sí':d.current===false?'No':'Por confirmar')}</select></label>${input('declaredDuration','Duración declarada')}<label class="wide">Fuente CV<select name="version_id" ${source?.version_id?'disabled':''}>${p.versions.map(v=>`<option value="${v.id}" ${v.id===source?.version_id?'selected':''}>Versión ${v.id} · ${esc(v.original)}</option>`).join('')||'<option value="">Sin CV; no se exporta hasta asociar una versión</option>'}</select></label><label class="wide">Fragmento de respaldo<textarea name="fragment" ${source?'readonly':''}>${esc(source?.fragment||'')}</textarea></label><fieldset class="wide"><legend>Categorías respaldadas por las tareas</legend>${p.categories.map(c=>`<label class="checkline"><input type="checkbox" name="categories" value="${esc(c)}" ${d.categories?.includes(c)?'checked':''}>${c}</label>`).join('')}</fieldset><label class="checkline wide"><input type="checkbox" name="confirm"> Confirmé estos datos con la fuente</label></div><div class="form-actions"><button type="button" id="backPerson">Volver</button><button class="primary">Guardar experiencia</button></div></form>`);bind('#backPerson','click',()=>personForm(p.id));bind('#experienceForm','submit',async e=>{e.preventDefault();const f=new FormData(e.target),data=Object.fromEntries(f);data.categories=f.getAll('categories');data.current=data.current==='Sí'?true:data.current==='No'?false:null;await api('/people/'+p.id+'/experiences',{method:'POST',body:{id:source?.id,revision:source?.revision,data,fragment:data.fragment,version_id:data.version_id||null,confirm:f.has('confirm')}});await personForm(p.id);});}
async function mergeForm(p){const all=await api('/candidates');modal(head('Unión explícita de fichas')+`<p>La ficha N.º ${p.id} se conservará como antecedente. Sus documentos, fuentes y recepciones pasarán a la ficha elegida. Verificá que se trate de la misma persona.</p><form id="mergeForm"><label>Ficha de destino<select name="target">${all.filter(x=>x.id!==p.id).map(x=>`<option value="${x.id}">N.º ${x.id} · ${esc(x.name)}</option>`).join('')}</select></label><label class="checkline"><input type="checkbox" required> Revisé las identidades y confirmo la unión.</label><button class="primary">Unir fichas conservando historial</button></form>`);bind('#mergeForm','submit',async e=>{e.preventDefault();const target=Number(e.target.elements.target.value),b=all.find(x=>x.id===target);await api('/people/'+p.id+'/merge',{method:'POST',body:{target,versions:{from:p.version,to:b.version}}});await personForm(target);});}
async function renderDownloads(){
  $('#content').innerHTML=heading('Descargá los CV por fecha.','Una versión por postulante, sin repetir archivos idénticos.')+`<div class="panel"><form id="downloadForm"><div class="form-grid"><label>Desde<input type="date" name="start" required value="${day()}"></label><label>Hasta<input type="date" name="end" required value="${day()}"></label><label class="wide">Qué incluir<select name="mode"><option value="new">Postulantes nuevos</option><option value="updated">CV nuevos o actualizados</option></select></label></div><p class="muted">Postulantes nuevos: primera recepción dentro del rango. CV nuevos o actualizados: versión incorporada en el rango. Los reenvíos idénticos no cuentan como novedades. Se incluye la última versión existente al cierre del día final, en horario argentino.</p><button class="primary">Vista previa</button></form><div id="exportPreview"></div></div>`;
  bind('#downloadForm','submit',async e=>{e.preventDefault();const body=Object.fromEntries(new FormData(e.target));const result=await api('/exports/preview',{method:'POST',body});$('#exportPreview').innerHTML=`<h3>${result.people} postulantes · ${result.files} archivos únicos</h3><p>${result.unresolved} adjuntos pendientes de resolución · ${result.missing.length} originales faltantes · ${result.reading} lecturas pendientes o con error.</p><p class="muted">El ZIP contiene los CV, indice.csv y experiencias.csv. Una lectura pendiente no impide descargar el original.</p>${result.rows.map(r=>`<p>N.º ${r.candidate_id} · ${esc(r.name)} · ${date(r.date)}</p>`).join('')}<button id="createExport" class="primary" ${result.unresolved||result.missing.length?'disabled':''}>Generar ZIP</button><div id="exportState"></div>`;bind('#createExport','click',async e=>{e.target.disabled=true;try{const job=await api('/exports',{method:'POST',body});const update=async()=>{const r=await api('/exports/'+job.id);if(!$('#exportState'))return;$('#exportState').innerHTML=r.state==='ready'?`<p><a class="download-link" href="/api/exports/${r.id}/download">Descargar ZIP listo</a></p>`:r.state==='error'?`<p class="error">${esc(r.error)}</p>`:'<p>Generando ZIP en segundo plano…</p>';if(r.state!=='building')clearInterval(poll);};await update();poll=setInterval(()=>update().catch(e=>toast(e.message)),1500);}catch(err){e.target.disabled=false;throw err;}});});
}
