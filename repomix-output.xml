async function documents(id){const docs=await api(`/candidates/${id}/documents`);$('#documents').innerHTML=docs.map(d=>`<details><summary>${esc(d.original)} · ${esc(d.status)}</summary><p><a href="/api/documents/${d.id}">Descargar original</a></p><pre>${esc(d.text||'Sin texto disponible todavía. Actualizá la lectura en unos instantes.')}</pre></details>`).join('')+'<button type="button" id="refreshDocs">Actualizar lectura</button>';bind('#refreshDocs','click',()=>documents(id));}
function importExcel(){modal(`${modalHead('Importar postulantes desde Excel')}<p>Se detecta la hoja EVALUACION o la primera hoja y sus encabezados. Los datos adicionales se conservan en notas. Revisá la vista previa antes de incorporar las fichas.</p><form id="excelForm" class="toolbar"><input type="file" name="file" accept=".xlsx" required><button class="primary">Leer archivo</button></form><div id="preview"></div>`);bind('#excelForm','submit',async e=>{e.preventDefault();const result=await api('/import/preview',{method:'POST',body:new FormData(e.target)});const good=result.rows.filter(r=>r.name);$('#preview').innerHTML=`<p>${esc(result.sheet)} · Encabezados en fila ${result.headerRow} · ${good.length} filas con nombre / ${result.rows.length} filas totales.</p><p class="muted">Columnas conservadas en notas: ${esc(result.headers.filter(h=>!h.field).map(h=>h.label).join(', ')||'Ninguna')}. Los resultados del Excel quedan como antecedentes; todas las fichas se importan pendientes de revisión.</p><div class="table-wrap"><table><thead><tr><th>Nombre</th><th>Contacto</th><th>Localidad</th><th>Licencia</th></tr></thead><tbody>${good.slice(0,100).map(r=>`<tr><td>${esc(r.name)}</td><td>${esc(r.phone||r.cvPhone)}</td><td>${esc(r.locality)}</td><td>${esc(r.license)}</td></tr>`).join('')}</tbody></table></div><p class="muted">Vista previa de hasta 100 filas. Duplicados exactos por nombre y ambos teléfonos se omiten. Las filas sin nombre no se importan.</p><button id="commitImport" class="primary" ${good.length?'':'disabled'}>Importar ${good.length} fichas</button>`;bind('#commitImport','click',async e=>{e.target.disabled=true;try{const r=await api('/import/commit',{method:'POST',body:{rows:good}});$('#modal').close();await refresh();render();toast(`${r.added} fichas importadas; ${r.skipped} duplicadas omitidas`);}finally{e.target.disabled=false;}});});}
function renderCampaigns(){$('#content').innerHTML=`<div class="heading"><div><h1>Conversaciones que abren puertas.</h1><p>Organizá entrevistas y registrá cada respuesta.</p></div><button id="newCampaign" class="primary">+ Nueva convocatoria</button></div>${campaigns.length?campaigns.map(c=>`<div class="panel"><div class="campaign"><div><h2>${esc(c.title)}</h2><p>${esc(c.date)} · ${esc(c.time)} hs · Cupo: ${c.capacity}</p><button data-campaign="${c.id}">Ver convocatoria ↗</button></div><div><strong>${c.invitations.length} / ${c.capacity}</strong><small>seleccionados</small></div><div><strong>${c.invitations.filter(i=>i.status==='Confirmó').length}</strong><small>confirmados</small></div></div></div>`).join(''):'<div class="panel empty"><strong>Prepará tu primera convocatoria</strong>Definí fecha, hora y cupo; luego agregá personas desde Postulantes.</div>'}<div class="notice">Las invitaciones se preparan para copiar. El envío y la confirmación se registran manualmente en esta etapa.</div>`;bind('#newCampaign','click',newCampaign);document.querySelectorAll('[data-campaign]').forEach(b=>b.onclick=()=>campaignDetail(Number(b.dataset.campaign)));}
function newCampaign(){modal(`${modalHead('Nueva convocatoria')}<form id="campaignForm"><div class="form-grid"><label class="wide">Título<input name="title" required placeholder="Entrevistas · Reparto y distribución"></label><label>Fecha<input name="date" type="date" required></label><label>Horario de inicio<input name="time" type="time" required></label><label>Cupo de postulantes<input name="capacity" type="number" min="1" max="1000" value="40" required></label></div><div class="form-actions"><button class="primary">Crear convocatoria</button></div></form>`);bind('#campaignForm','submit',async e=>{e.preventDefault();await api('/campaigns',{method:'POST',body:Object.fromEntries(new FormData(e.target))});$('#modal').close();await refresh();render();});}
function addToCampaign(){if(!selected.size)return toast('Seleccioná al menos un postulante');if(!campaigns.length){view='campaigns';render();return newCampaign();}modal(`${modalHead('Agregar a una convocatoria')}<p>${selected.size} postulantes seleccionados, incluidos los que no se ven por los filtros.</p><form id="assignForm"><label>Convocatoria<select name="campaign">${campaigns.map(c=>`<option value="${c.id}">${esc(c.title)} · ${c.invitations.length}/${c.capacity}</option>`).join('')}</select></label><p class="muted">Agregar personas no envía mensajes.</p><button class="primary">Agregar selección</button></form>`);bind('#assignForm','submit',async e=>{e.preventDefault();await api(`/campaigns/${e.target.elements.campaign.value}/invitations`,{method:'POST',body:{ids:[...selected]}});selected.clear();$('#modal').close();await refresh();render();toast('Selección agregada a la convocatoria');});}
function campaignDetail(id){const c=campaigns.find(c=>c.id===id);modal(`${modalHead(c.title)}<p>${esc(c.date)} · ${esc(c.time)} hs · ${c.invitations.length}/${c.capacity} seleccionados · ${c.invitations.filter(i=>i.status==='Confirmó').length} confirmados</p><div class="table-wrap"><table><thead><tr><th>Postulante</th><th>Respuesta / asistencia</th><th>Invitación</th></tr></thead><tbody>${c.invitations.map(i=>`<tr><td>${esc(i.name)}<br><small>${esc(i.phone||'Sin teléfono')}</small></td><td><select aria-label="Estado de ${esc(i.name)}" data-invite="${i.candidate_id}">${options(['Seleccionado','Invitado','Confirmó','No puede asistir','Sin respuesta','Asistió','No asistió'],i.status)}</select></td><td><button data-message="${i.candidate_id}">Preparar texto</button></td></tr>`).join('')}</tbody></table></div><div id="messageArea"></div>`);document.querySelectorAll('[data-invite]').forEach(s=>s.onchange=async()=>{try{await api(`/campaigns/${id}/invitations/${s.dataset.invite}`,{method:'PUT',body:{status:s.value}});await refresh();render();toast('Estado actualizado');}catch(e){toast(e.message);s.value=c.invitations.find(i=>i.candidate_id===Number(s.dataset.invite)).status;}});document.querySelectorAll('[data-message]').forEach(b=>b.onclick=()=>{const i=c.invitations.find(i=>i.candidate_id===Number(b.dataset.message));$('#messageArea').innerHTML=`<h3>Invitación para revisar y copiar</h3><textarea id="messageText" rows="6">${esc(`Hola ${i.name}, te contactamos de IVESS por tu postulación. Queremos invitarte a una entrevista el ${c.date} a las ${c.time} hs en Juan Manuel de Rosas 21028, Virrey del Pino. ¿Podés confirmar tu asistencia? ¡Gracias!`)}</textarea><p class="muted">Verificá el destinatario y el horario. Copiar el texto no envía el mensaje ni cambia el estado.</p><button id="copyMessage">Seleccionar texto para copiar</button>`;$('#copyMessage').onclick=()=>{$('#messageText').select();toast('Texto seleccionado. Usá Ctrl+C para copiar.');};});}
function renderSettings(){$('#content').innerHTML=`<div class="heading"><div><h1>Tu espacio de trabajo.</h1><p>Administración del servidor y conexiones.</p></div></div><div class="panel"><h2>WhatsApp</h2><span class="badge">Pendiente de integración</span><p>Cuenta prevista: +54 9 11 5147-5803. La sesión propia de RR. HH. se conectará al incorporar el proyecto Transferencias de referencia.</p><small>Esta versión no vincula, importa conversaciones ni envía mensajes.</small></div><div class="panel"><h2>Lectura y evaluación</h2><p>PDF con texto: extracción directa. PDF escaneado e imágenes: OCR local. El texto original queda junto al archivo para verificar los datos.</p><p class="muted">No se calculan distancias por localidad ni se descartan personas automáticamente por edad. La licencia, disponibilidad, experiencia y traslado se revisan en cada ficha.</p></div>${me.role==='admin'?'<div class="panel"><h2>Nuevo usuario</h2><form id="userForm" class="form-grid"><label>Usuario<input name="username" required autocomplete="off"></label><label>Contraseña (mínimo 12 caracteres)<input name="password" type="password" minlength="12" required autocomplete="new-password"></label><div><button class="primary">Crear usuario</button></div></form></div><div class="panel"><h2>Copias de seguridad</h2><p>Guarda una copia de la base central y los CV en la carpeta backups del servidor.</p><button id="backup">Crear copia ahora</button><p id="backupResult" class="muted"></p></div>':''}`;bind('#userForm','submit',async e=>{e.preventDefault();await api('/users',{method:'POST',body:Object.fromEntries(new FormData(e.target))});e.target.reset();toast('Usuario creado');});bind('#backup','click',async e=>{e.target.disabled=true;try{const r=await api('/backup',{method:'POST'});$('#backupResult').textContent='Copia creada: '+r.path;}finally{e.target.disabled=false;}});}
boot().catch(()=>showLogin());
</file>

