p:1px solid #e0e6e0}dialog{width:820px;max-width:95vw;border:0;border-radius:13px;padding:30px;color:inherit;max-height:90vh;box-shadow:0 20px 100px #1232}dialog::backdrop{background:#172e2866;backdrop-filter:blur(2px)}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin:20px 0}.wide{grid-column:1/-1}.modal-head{display:flex;justify-content:space-between;align-items:center}.modal-head button{border:0;font-size:20px}.form-actions{display:flex;justify-content:flex-end;gap:10px;border-top:1px solid #e5eae4;padding-top:18px}.login{min-height:100vh;display:grid;place-items:center;background:radial-gradient(ellipse at top left,#dcebdc,transparent 70%)}.login-card{width:440px;max-width:92vw;background:white;padding:42px;border:1px solid #dae4d8;border-radius:14px}.login-card h1{font-size:26px;margin-top:40px}.login-card form{display:grid;gap:18px;margin-top:30px}#loginError{color:#ae443d;font-size:13px;margin:0}#toast{position:fixed;bottom:25px;right:25px;max-width:450px;padding:17px 24px;background:#173f30;color:white;border-radius:8px;box-shadow:0 10px 40px #0002;z-index:10}pre{white-space:pre-wrap;max-height:250px;overflow:auto;font:12px/1.6 Consolas,monospace;background:#f5f7f4;padding:14px}a{color:#196c49}.campaign{display:flex;justify-content:space-between;gap:20px;align-items:center}.campaign p{font-size:13px}.campaign strong{font-size:22px}.campaign small{display:block}details{margin-top:16px}.error{color:#ac403b}input:focus,select:focus,textarea:focus,button:focus-visible{outline:2px solid #85b399;outline-offset:2px}[hidden]{display:none!important}@media(max-width:1000px){aside{width:185px;padding:28px 15px}main{margin-left:185px}#content{padding:25px}.heading{align-items:flex-start;flex-direction:column}.stats{gap:10px}.stat{padding:15px}header{padding:0 25px}.location{display:none}.filters{grid-template-columns:1fr 1fr}}@media(max-width:650px){aside{position:static;width:auto;padding:18px}.brand{font-size:30px}.brand span{display:none}.nav-title,.aside-bottom{display:none}nav{display:flex;margin-top:15px}nav button{font-size:12px;padding:8px}main{margin:0}header{height:50px}#content{padding:20px 14px}.stats{grid-template-columns:1fr 1fr}.actions{flex-wrap:wrap}.form-grid{grid-template-columns:1fr}.wide{grid-column:auto}.panel{padding:15px}.toolbar{flex-wrap:wrap}footer span{display:none}dialog{padding:20px}}
/* Identidad visual IVESS / Atilio Etchelar, tomada del separador de referencia. */
:root{--navy:#064275;--blue:#0a67aa;--aqua:#21b4dc;--pale:#edf8fd;--line:#cfe2ec;color:#162b3b;background:#eaf5fb}
body{min-height:100vh;background:radial-gradient(circle at 95% 5%,#21b4dc25,transparent 32rem),linear-gradient(145deg,#f8fcff,#eaf6fc 65%,#e0f1fa)}
button{border-color:var(--line);border-radius:11px;padding:11px 16px;color:var(--blue);font-weight:600;transition:background .16s,box-shadow .16s}
button:hover{background:#eef8fd;border-color:#8bc4dc;box-shadow:0 4px 12px #0642750b}
.primary{background:linear-gradient(105deg,var(--navy),var(--blue) 65%,#158fbe);border-color:transparent;color:white;box-shadow:0 7px 17px #06427524}
.primary:hover{background:linear-gradient(105deg,#07518b,#087cbe 70%,#19a0cc);border-color:transparent}
input,select,textarea{border-color:#c6dce8;border-radius:10px;padding:11px 12px;min-width:0;color:#162b3b}
input::placeholder{color:#6e8594}input[type=checkbox]{accent-color:var(--blue);width:17px;height:17px;cursor:pointer}
input[type=file]{background:var(--pale);border-style:dashed;font-size:12px}input::file-selector-button{border:0;border-radius:6px;background:#d9edf8;color:var(--navy);padding:7px 10px;margin-right:12px}
label{color:var(--navy);font-weight:600}small,p,.muted{color:#586f7e}small{font-weight:400}
h1{font-size:clamp(26px,2.4vw,36px);line-height:1.15;letter-spacing:-1.1px;font-weight:750;color:var(--navy)}h2,h3{color:var(--navy)}
aside{width:244px;background:linear-gradient(180deg,#fff 35%,#f1f9fd);border-color:var(--line);padding:35px 20px 24px;z-index:2}
.brand{line-height:1;text-align:center;padding:0 12px}.brand img{display:block;width:100%;max-width:185px;height:66px;object-fit:contain;margin:auto}.brand span{font-size:9px;letter-spacing:2.1px;margin-top:13px;color:var(--blue);font-weight:750}
.nav-title{font-size:10px;font-weight:650;letter-spacing:1.3px;margin:47px 13px 15px;color:#647f90}
nav button{color:#547286;border-radius:12px;padding:14px}nav button.active{background:linear-gradient(105deg,var(--navy),var(--blue));color:white;box-shadow:0 7px 16px #06427525}
.aside-bottom{color:#547286;padding:18px 12px 0;border-top:1px solid var(--line)}.aside-bottom p{color:var(--navy);font-weight:650}.aside-bottom button{background:transparent}.dot{background:#269d7a;box-shadow:0 0 0 3px #269d7a17}
main{margin-left:244px}header{height:92px;padding:15px 38px;gap:20px;background:#ffffffbd;border-color:#d1e6f0;font-size:10px;color:var(--blue)}header b{font-weight:600;font-size:12px;color:var(--navy)}
.header-brand{display:flex;gap:23px;align-items:center}.header-brand img{width:128px;height:51px;object-fit:contain}.location{color:#586f7e;font-size:11px}
#content{padding:34px 38px;min-height:calc(100vh - 146px);max-width:1700px;margin:auto}.heading{gap:22px}.heading p{font-size:13px}
#content>.heading{position:relative;padding:30px 28px 28px;background:linear-gradient(115deg,#ffffffef,#f4fbffdd);border:1px solid #c5deeb;border-radius:20px;box-shadow:0 12px 36px #0642750d;overflow:hidden}
#content>.heading::before{content:'';position:absolute;inset:0 0 auto;height:5px;background:linear-gradient(90deg,var(--navy),var(--blue) 55%,var(--aqua))}
.actions{flex-shrink:0;font-size:13px}.stats{grid-template-columns:repeat(4,minmax(0,1fr));margin-bottom:25px}
.stat,.panel{background:#ffffffed;border:1px solid var(--line);border-radius:17px;box-shadow:0 12px 36px #0642750d}
.stat{position:relative;padding:21px 23px;overflow:hidden}.stat::after{content:'';position:absolute;right:-17px;bottom:-24px;width:90px;height:90px;border:16px solid #21b4dc09;border-radius:50%;pointer-events:none}
.stat small{font-size:11px;text-transform:uppercase;font-weight:700;letter-spacing:.65px;color:var(--blue)}.stat strong{font-size:35px;margin:10px 0 5px;font-weight:750;color:var(--navy);line-height:1.1}.stat span{color:#586f7e}
.stat:first-child{padding-top:21px;background:linear-gradient(120deg,#064275,#0a67aa);border:1px solid #0a67aa}.stat:first-child small{color:#d4efff}.stat:first-child strong{color:white}.stat:first-child span{color:#d1e9f7}.stat:first-child::after{border-color:#ffffff0a}
.panel{padding:25px;overflow:hidden}.panel>.heading{margin-bottom:18px}.panel>.heading h2{margin:0}.filters{gap:11px;font-size:12px}
.table-wrap{border:1px solid #dceaf2;border-radius:12px}th{font-weight:700;color:#416985;font-size:10px;letter-spacing:.7px;background:#edf7fc;padding:14px 12px;border-color:#d7e8f2}td{border-color:#e6f0f6}tbody tr:last-child td{border-bottom:0}tbody tr:hover{background:#f5fbfe}tbody tr:has(input:checked){background:#edf8fd}td button{border-radius:8px;font-size:11px}
.person{font-weight:600;color:var(--navy)}.avatar{background:linear-gradient(140deg,#e1f2fb,#d0eaf8);color:var(--blue);width:38px;height:38px;border-radius:12px;border:1px solid #c1e2f2}
.badge{background:#fff4dc;color:#805a16;font-weight:600;display:inline-block}.badge.green{background:#e5f5ee;color:#237150}
